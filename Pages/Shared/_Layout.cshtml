<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BirikimPro</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- ICONS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
          rel="stylesheet">

    <style>
        /* NAVBAR */
        .navbar-glass {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .nav-link {
            color: #e5e7eb !important;
            font-weight: 500;
            transition: color .2s ease;
        }

        .nav-link:hover {
            color: #22c55e !important;
        }

        .btn-logout {
            background: linear-gradient(90deg, #ef4444, #dc2626);
            border: none;
            color: white;
            font-weight: 600;
            padding: .35rem .75rem;
            border-radius: 10px;
        }
    </style>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-glass fixed-top">
        <div class="container">

            <a class="navbar-brand text-light" href="/">
                💸 BirikimPro
            </a>

            <button class="navbar-toggler text-light"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center gap-2">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Hedefim">
                                🎯 Hedeflerim
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Identity/Account/Manage">
                                👤 Profilim
                            </a>
                        </li>

                        <li class="nav-item">
                            <form method="post"
                                asp-area="Identity"
                                asp-page="/Account/Logout">
                                <button type="submit"
                                        class="btn btn-outline-light btn-sm">
                                    🚪 Çıkış Yap
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                            href="/Identity/Account/Login">
                                Giriş Yap
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-success btn-sm px-3"
                            href="/Identity/Account/Register">
                                Kayıt Ol
                            </a>
                        </li>
                    }

                </ul>

            </div>
        </div>
    </nav>

    <!-- SAYFA -->
    <main class="pt-5 mt-4">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)




    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    

    


</body>
</html>
