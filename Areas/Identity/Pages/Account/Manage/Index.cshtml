@page
@model IndexModel
@{
    ViewData["Title"] = "Profilim";
}

<style>
    body {
        background: radial-gradient(circle at top,
            #1e293b,
            #0f172a 60%,
            #020617 100%);
        color: #e5e7eb;
    }

    .glass-card {
        background: rgba(255,255,255,0.06);
        backdrop-filter: blur(16px);
        border-radius: 22px;
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 20px 45px rgba(0,0,0,0.4);
        transition: transform .35s ease, box-shadow .35s ease;
    }

    .glass-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 30px 60px rgba(0,0,0,0.55);
    }

    .profile-avatar {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: linear-gradient(135deg, #22c55e, #8b5cf6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        font-weight: 800;
        color: #022c22;
        margin: 0 auto 1rem;
    }

    .stat-number {
        font-size: 1.8rem;
        font-weight: 800;
    }

    .stat-label {
        font-size: .9rem;
        color: #cbd5f5;
    }

    .form-control {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        color: #e5e7eb;
    }

    .form-control:focus {
        background: rgba(255,255,255,0.12);
        color: #fff;
    }

    /* text-muted yazıları dark temada görünür yap */
    .glass-card .text-muted {
        color: #cbd5f5 !important;
    }

    /* disabled e-posta input yazısı */
    input.form-control:disabled {
        color: #e5e7eb !important;
        opacity: 1;
        background: rgba(255,255,255,0.08);
    }


</style>

<div class="container mt-5">

    <div class="row g-4 justify-content-center">

        <!-- PROFİL KARTI -->
        <div class="col-md-4">
            <div class="glass-card p-4 text-center">
                <div class="profile-avatar">
                    @User.Identity?.Name?.Substring(0,1).ToUpper()
                </div>

                <h5>@User.Identity?.Name</h5>
                <p class="text-muted">BirikimPro kullanıcısı</p>
            </div>
        </div>

        <!-- İSTATİSTİKLER -->
        <div class="col-md-4">
            <div class="glass-card p-4 text-center h-100">
                <h6 class="mb-3">📊 İstatistikler</h6>

                <div class="mb-3">
                    <div class="stat-number">@Model.HedefSayisi</div>
                    <div class="stat-label">Toplam Hedef</div>
                </div>

                <div>
                    <div class="stat-number">@Model.ToplamBirikim ₺</div>
                    <div class="stat-label">Birikmiş Para</div>
                </div>
            </div>
        </div>

        <!-- HESAP AYARLARI -->
        <div class="col-md-4">
            <div class="glass-card p-4 h-100">
                <h6 class="mb-3 text-center">⚙️ Hesap Ayarları</h6>

                <div class="d-grid gap-2">
                    <a class="btn btn-outline-light"
                       asp-page="./ChangePassword">
                        🔐 Şifre Değiştir
                    </a>

                    <a class="btn btn-outline-danger"
                       asp-page="./DeletePersonalData">
                        🗑️ Hesabı Sil
                    </a>
                </div>
            </div>
        </div>

    </div>

    <!-- E-POSTA -->
    <div class="row justify-content-center mt-4">
        <div class="col-md-6">
            <div class="glass-card p-4">
                <h6 class="mb-3">📧 E-Posta Bilgisi</h6>

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">E-Posta</label>
                        <input asp-for="Email"
                               class="form-control"
                               disabled />
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>
