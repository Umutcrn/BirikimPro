@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Hesabı Sil";
}

<style>
    body {
        background: radial-gradient(circle at top,
            #3b0a0a,
            #1f0505 60%,
            #020617 100%);
        color: #fee2e2;
    }

    .delete-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .danger-card {
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(16px);
        border-radius: 22px;
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 20px 45px rgba(0,0,0,0.5);
        max-width: 520px;
        width: 100%;
    }

    .danger-title {
        font-weight: 800;
        font-size: 1.8rem;
        text-align: center;
        color: #fecaca;
    }

    .danger-sub {
        text-align: center;
        color: #fca5a5;
        font-size: .95rem;
        margin-bottom: 1.4rem;
    }

    .warning-box {
        background: rgba(220,38,38,0.15);
        border: 1px solid rgba(220,38,38,0.4);
        border-radius: 14px;
        padding: 1rem;
        font-size: .9rem;
        color: #fee2e2;
    }

    .form-control {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        color: #fee2e2;
    }

    .form-control:focus {
        background: rgba(255,255,255,0.12);
        color: #fff;
    }

    .btn-danger {
        background: linear-gradient(90deg, #dc2626, #991b1b);
        border: none;
        font-weight: 700;
        color: #fff;
    }

    .btn-danger:hover {
        box-shadow: 0 0 25px rgba(220,38,38,.6);
    }

    .btn-cancel {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        color: #e5e7eb;
    }

    .btn-cancel:hover {
        background: rgba(255,255,255,0.15);
    }

    .text-danger {
        font-size: .85rem;
    }
</style>

<div class="delete-wrapper">
    <div class="danger-card p-4">

        <div class="danger-title">⚠️ Hesabını Silmek Üzeresin</div>
        <div class="danger-sub">
            Bu işlem geri alınamaz
        </div>

        <div class="warning-box mb-4">
            <ul class="mb-0">
                <li>Tüm hedeflerin kalıcı olarak silinir</li>
                <li>Birikim geçmişin tamamen kaybolur</li>
                <li>Bu hesaba bir daha erişemezsin</li>
            </ul>
        </div>

        <form method="post">

            @if (Model.RequirePassword)
            {
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">
                        Şifreni gir
                    </label>
                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="current-password" />
                    <span asp-validation-for="Input.Password"
                          class="text-danger"></span>
                </div>
            }

            <div class="d-grid gap-2 mt-4">
                <button type="submit"
                        class="btn btn-danger">
                    🗑️ Hesabımı Kalıcı Olarak Sil
                </button>

                <a asp-page="./Index"
                   class="btn btn-cancel">
                    Vazgeç
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
