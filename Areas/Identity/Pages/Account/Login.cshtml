@page
@model LoginModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<style>
    body {
        background: radial-gradient(circle at top,
            #1e293b,
            #0f172a 60%,
            #020617 100%);
        color: #e5e7eb;
    }

    .login-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .glass-card {
        background: rgba(255,255,255,0.06);
        backdrop-filter: blur(16px);
        border-radius: 22px;
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 20px 45px rgba(0,0,0,0.4);
        width: 100%;
        max-width: 420px;
    }

    .login-title {
        font-weight: 800;
        font-size: 1.8rem;
        text-align: center;
    }

    .login-sub {
        text-align: center;
        color: #cbd5f5;
        font-size: .95rem;
        margin-bottom: 1.5rem;
    }

    .form-control {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        color: #e5e7eb;
    }

    .form-control:focus {
        background: rgba(255,255,255,0.12);
        color: #fff;
    }

    .form-label {
        color: #cbd5f5;
        font-weight: 500;
    }

    .login-btn {
        background: linear-gradient(90deg, #22c55e, #16a34a);
        border: none;
        font-weight: 600;
        color: #022c22;
    }

    .login-btn:hover {
        box-shadow: 0 0 18px rgba(34,197,94,.6);
    }

    .login-footer {
        text-align: center;
        font-size: .9rem;
        margin-top: 1rem;
    }

    .login-footer a {
        color: #22c55e;
        font-weight: 600;
        text-decoration: none;
    }

    .login-footer a:hover {
        text-decoration: underline;
    }

    .text-danger {
        font-size: .85rem;
    }
</style>

<div class="login-wrapper">
    <div class="glass-card p-4">

        <div class="login-title">👋 Hoş Geldin</div>
        <div class="login-sub">
            BirikimPro hesabına giriş yap
        </div>

        <form method="post">

            <div class="mb-3">
                <label asp-for="Input.Email"
                       class="form-label">
                    E-Posta
                </label>
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username" />
                <span asp-validation-for="Input.Email"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Password"
                       class="form-label">
                    Şifre
                </label>
                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="current-password" />
                <span asp-validation-for="Input.Password"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn login-btn w-100">
                🔐 Giriş Yap
            </button>
        </form>

        <div class="login-footer">
            Hesabın yok mu?
            <a asp-page="./Register">Kayıt Ol</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
