@page
@model RegisterModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<style>
    body {
        background: radial-gradient(circle at top,
            #1e293b,
            #0f172a 60%,
            #020617 100%);
        color: #e5e7eb;
    }

    .register-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .glass-card {
        background: rgba(255,255,255,0.06);
        backdrop-filter: blur(16px);
        border-radius: 22px;
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 20px 45px rgba(0,0,0,0.4);
        width: 100%;
        max-width: 460px;
    }

    .register-title {
        font-weight: 800;
        font-size: 1.9rem;
        text-align: center;
    }

    .register-sub {
        text-align: center;
        color: #cbd5f5;
        font-size: .95rem;
        margin-bottom: 1.5rem;
    }

    .form-control {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        color: #e5e7eb;
    }

    .form-control:focus {
        background: rgba(255,255,255,0.12);
        color: #fff;
    }

    .form-label {
        color: #cbd5f5;
        font-weight: 500;
    }

    .register-btn {
        background: linear-gradient(90deg, #38bdf8, #2563eb);
        border: none;
        font-weight: 600;
        color: #020617;
    }

    .register-btn:hover {
        box-shadow: 0 0 20px rgba(56,189,248,.6);
    }

    .register-footer {
        text-align: center;
        font-size: .9rem;
        margin-top: 1rem;
    }

    .register-footer a {
        color: #38bdf8;
        font-weight: 600;
        text-decoration: none;
    }

    .register-footer a:hover {
        text-decoration: underline;
    }

    .text-danger {
        font-size: .85rem;
    }
</style>

<div class="register-wrapper">
    <div class="glass-card p-4">

        <div class="register-title">🚀 Aramıza Katıl</div>
        <div class="register-sub">
            BirikimPro ile hedeflerine bugünden başla
        </div>

        <form method="post">

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">
                    E-Posta
                </label>
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username" />
                <span asp-validation-for="Input.Email"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Password" class="form-label">
                    Şifre
                </label>
                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="new-password" />
                <span asp-validation-for="Input.Password"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn register-btn w-100">
                ✨ Kayıt Ol
            </button>
        </form>

        <div class="register-footer">
            Zaten hesabın var mı?
            <a asp-page="./Login">Giriş Yap</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
